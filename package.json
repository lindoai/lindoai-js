{
  "name": "lindoai",
  "version": "1.1.5",
  "description": "TypeScript SDK for the Lindo API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "lindoai",
    "lindo",
    "sdk",
    "api",
    "typescript"
  ],
  "author": "Lindo AI <hello@lindo.ai>",
  "license": "MIT",
  "homepage": "https://lindo.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/lindoai/lindoai-js"
  },
  "bugs": {
    "url": "https://github.com/lindoai/lindoai-js/issues"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18",
    "fast-check": "^3.23.2"
  }
}
